rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token != null && request.auth.token.email != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'atahershihab151@gmail.com' ||
        (exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.role == 'Super Admin')
      );
    }

    function isAuthorizedUser() {
      return isSignedIn() && (
        request.auth.token.email == 'atahershihab151@gmail.com' ||
        exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Authorized users collection
    match /authorized_users/{userEmail} {
      allow read: if isAuthorizedUser();
      allow write: if isSuperAdmin();
    }

    // Products collection
    match /products/{productId} {
      allow read: if isAuthorizedUser();
      allow write: if isAuthorizedUser() && isValidId(productId);
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isAuthorizedUser();
      allow write: if isAuthorizedUser() && isValidId(customerId);
    }

    // Treatment records collection
    match /treatmentRecords/{recordId} {
      allow read: if isAuthorizedUser();
      allow write: if isAuthorizedUser() && isValidId(recordId);
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isAuthorizedUser();
      allow write: if isAuthorizedUser() && isValidId(transactionId);
    }
  }
}
