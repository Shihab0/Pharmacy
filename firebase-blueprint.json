{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Veterinary medicine and agrovet inventory item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "genericName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["Medicine", "Vaccine", "Feed", "Supplement", "Equipment"] },
        "targetAnimal": { "type": "string", "enum": ["Cattle", "Poultry", "Goat/Sheep", "Pet", "Aqua/All"] },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "expiryDate": { "type": "string", "maxLength": 20 },
        "batchNumber": { "type": "string", "maxLength": 100 },
        "dosageInfo": { "type": "string", "maxLength": 500 },
        "supplier": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "category", "targetAnimal", "costPrice", "sellingPrice", "stock", "unit", "expiryDate", "batchNumber"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Farmer or pet owner record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 500 },
        "farmType": { "type": "string", "maxLength": 200 },
        "totalSpent": { "type": "number" },
        "dueBalance": { "type": "number" },
        "lastVisit": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "name", "phone", "address", "farmType", "totalSpent", "dueBalance", "lastVisit"]
    },
    "TreatmentRecord": {
      "title": "TreatmentRecord",
      "description": "Veterinary treatment or prescription log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 30 },
        "farmerName": { "type": "string", "maxLength": 200 },
        "farmerPhone": { "type": "string", "maxLength": 30 },
        "animalType": { "type": "string", "maxLength": 100 },
        "tagOrName": { "type": "string", "maxLength": 100 },
        "symptoms": { "type": "string", "maxLength": 1000 },
        "diagnosis": { "type": "string", "maxLength": 1000 },
        "vetDoctorOrTech": { "type": "string", "maxLength": 200 },
        "followUpDate": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["Completed", "Follow-up Needed", "Critical"] },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "date", "farmerName", "farmerPhone", "animalType", "symptoms", "diagnosis", "vetDoctorOrTech", "status"]
    },
    "SaleTransaction": {
      "title": "SaleTransaction",
      "description": "POS Invoice transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "invoiceNo": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "grandTotal": { "type": "number" },
        "totalCost": { "type": "number" },
        "netProfit": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Mobile Banking", "Card", "Credit / Due"] },
        "handledByRole": { "type": "string", "enum": ["Super Admin", "Staff"] },
        "staffName": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "invoiceNo", "timestamp", "customerName", "subtotal", "grandTotal", "paymentMethod", "handledByRole"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Veterinary medicine and feed inventory products"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Registered farmers and customers"
    },
    "/treatmentRecords/{recordId}": {
      "schema": { "$ref": "#/entities/TreatmentRecord" },
      "description": "Animal prescription and treatment logs"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/SaleTransaction" },
      "description": "Sales invoice memos and revenue records"
    }
  }
}
